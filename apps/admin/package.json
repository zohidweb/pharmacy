{
  "name": "@pharmacy/admin",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "admin",
    "sourceRoot": "apps/admin/src",
    "tags": [
      "scope:admin",
      "type:app"
    ],
    "targets": {
      "dev": {
        "options": {
          "command": "next dev -p 4300",
          "env": {
            "NEXT_PUBLIC_API_MOCKS": "true"
          }
        }
      },
      "fsd": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/src/**/*",
          "{projectRoot}/steiger.config.mjs"
        ],
        "options": {
          "command": "steiger ./src",
          "cwd": "{projectRoot}"
        }
      }
    }
  },
  "dependencies": {
    "next": "~16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
