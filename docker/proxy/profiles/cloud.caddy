# Cloud (ADR-0020): app.<domain> — web and /api, admin.<domain> — the operator admin, apex — by APEX_MODE (W13):
# a redirect to web (the default) or the public site (ADR-0023).
{$WEB_ADDR} {
	import web-site
}

{$ADMIN_ADDR} {
	import admin-site
}

import /etc/caddy/profiles/apex/{$APEX_MODE:redirect}.caddy
