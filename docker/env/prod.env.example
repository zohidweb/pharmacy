# prod environment. Copy to docker/env/prod.env (never commit it) or run: npm run stack -- prod init
# It holds no secrets: they are files in SECRETS_DIR on the VPS only, made there by `secrets init` (ADR-0021,
# docs/guides/deploy-vps.md). `npm run stack -- prod build` and `up` refuse a file that still holds secrets.
APP_ENV=prod
POSTGRES_DB=pharmacy
POSTGRES_SUPERUSER=postgres
# Secrets (ADR-0021): one file per secret in SECRETS_DIR, relative to docker/ — never in this file. On the VPS
# `dc --profile tools run --rm secrets init` creates them with random values and `… secrets check` checks them
# (docs/guides/deploy-vps.md); the directory is 0700, the files 0444; never open them in chats or with AI assistants.
SECRETS_DIR=./secrets/prod
REDIS_MAXMEMORY=768mb
# Authentication (ADR-0008): the active ids of the key rings; the rings are the secret files session_jwt_keys and
# password_peppers.
SESSION_JWT_ACTIVE_KID=k1
PASSWORD_PEPPER_ACTIVE=1
# Reverse proxy and hosting (ADR-0012, ADR-0020): Let's Encrypt for nurmed.online. DNS A records of app., admin. and the
# apex must point to the VPS before the first start, and port 80 must be open — or the certificate is not issued.
PROXY_PROFILE=cloud
TLS_MODE=acme
# Let's Encrypt account (expiry notices). Required.
ACME_EMAIL=
PROXY_BIND_ADDR=0.0.0.0
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
WEB_ADDR=app.nurmed.online
ADMIN_ADDR=admin.nurmed.online
# The addresses that reach admin.nurmed.online, the operator admin and /api/v1/operator/* (security review 2026-10-22,
# A1): the public IPs of the operator offices or of the VPN, CIDR, space-separated, e.g. 203.0.113.10/32 198.51.100.0/28.
# Required; others get 403.
OPERATOR_ALLOW=
APEX_ADDR=nurmed.online
# Origins of the web apps (CSRF Origin check of the API) — the same hosts over https, no port.
WEB_ORIGIN=https://app.nurmed.online
ADMIN_ORIGIN=https://admin.nurmed.online
# Number of reverse proxies in front of the API: 1 = Caddy (stack.md, question 13; decision 7.2 of the security review
# 2026-10-22). The API refuses to start in prod with 0 or with http:// origins. A wrong value lets clients spoof
# X-Forwarded-For (too high) or merges all clients into one rate-limit bucket (too low).
TRUST_PROXY=1
# Backups (ADR-0019). Directory of the copies on the host: a separate disk or a network volume, not the Docker data
# disk; this file and the secrets (keys, peppers, passwords) are not in the copies — `env-push` keeps them. Linux:
#   sudo install -d -o 70 -g 70 -m 700 <dir>   (uid 70 = postgres in the image)
# Docker Desktop on Windows: a host path such as C:/pharmacy-backups/prod
BACKUP_DIR=/srv/pharmacy-backups/prod
# Daily copy time HH:MM, Asia/Dushanbe; no deploys or manual migrations while a copy runs.
BACKUP_TIME=02:00
BACKUP_RETENTION_DAYS=30
# Copies off the host (ADR-0020, spec 2026-10-23-offsite-backups): every verified copy is encrypted with age for the
# public keys of the keepers and uploaded with rclone to Contabo Object Storage in another region than the VPS. The
# bucket has Object Lock (COMPLIANCE, 30 days) and expires objects after 31 days; the host never deletes there.
# Empty BACKUP_OFFSITE_BUCKET — nothing leaves the host (prod reports the backup service unhealthy).
BACKUP_OFFSITE_BUCKET=
# Public keys age1… of the two keepers, space-separated (age-keygen on their machines; the private keys never reach
# the server).
BACKUP_AGE_RECIPIENTS=
# rclone remote "offsite" by variables only: type s3, provider Ceph, endpoint of the region
# (https://usc1.contabostorage.com or https://sin1.contabostorage.com), the id of the S3 key, path-style addressing;
# the S3 key itself is the secret file offsite_secret_access_key.
RCLONE_CONFIG_OFFSITE_TYPE=s3
RCLONE_CONFIG_OFFSITE_PROVIDER=Ceph
RCLONE_CONFIG_OFFSITE_ENDPOINT=
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
RCLONE_CONFIG_OFFSITE_FORCE_PATH_STYLE=true
