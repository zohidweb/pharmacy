# prod environment. Copy to docker/env/prod.env (never commit it) or run: npm run stack -- prod init
# Placeholders are replaced with random values by `init`. Until an ADR selects a secret store
# (stack.md, question 8) this file lives only on the prod host, readable by its operator only.
APP_ENV=prod
API_PORT=3200
POSTGRES_DB=pharmacy
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me
PHARMACY_OWNER_PASSWORD=change-me
PHARMACY_APP_PASSWORD=change-me
PHARMACY_PLATFORM_PASSWORD=change-me
REDIS_PASSWORD=change-me
REDIS_MAXMEMORY=768mb
# Authentication (ADR-0008). `init` replaces `generate-key` with 32 random bytes (base64url).
SESSION_JWT_KEYS=k1:generate-key
SESSION_JWT_ACTIVE_KID=k1
PASSWORD_PEPPERS=1:generate-key
PASSWORD_PEPPER_ACTIVE=1
# Origins of the web apps (CSRF Origin check): scheme://host[:port], no path. Set the real HTTPS origins before the first deploy.
WEB_ORIGIN=https://web.pharmacy.example
# Number of reverse proxies in front of the API (0-5, default 0 = none). Set the real hop count with the reverse proxy
# (ADR-0012): a wrong value lets clients spoof X-Forwarded-For (too high) or merges all clients into one
# rate-limit bucket (too low).
# TRUST_PROXY=0
ADMIN_ORIGIN=https://admin.pharmacy.example
# Backups (ADR-0019): the password of the read-only role pharmacy_backup; `init` replaces change-me.
PHARMACY_BACKUP_PASSWORD=change-me
# Directory of the copies on the host: a separate disk or a network volume, not the Docker data disk; the env file
# (keys, peppers, passwords) is not in the copies and is kept separately. Linux:
#   sudo install -d -o 70 -g 70 -m 700 <dir>   (uid 70 = postgres in the image)
# Docker Desktop on Windows: a host path such as C:/pharmacy-backups/prod
BACKUP_DIR=/srv/pharmacy-backups/prod
# Daily copy time HH:MM, Asia/Dushanbe; no deploys or manual migrations while a copy runs.
BACKUP_TIME=02:00
BACKUP_RETENTION_DAYS=30
