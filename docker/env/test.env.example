# test environment. Copy to docker/env/test.env (never commit it) or run: npm run stack -- test init
# Placeholders are replaced with random values by `init`.
APP_ENV=test
API_PORT=3100
POSTGRES_PORT=5433
POSTGRES_DB=pharmacy
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me
PHARMACY_OWNER_PASSWORD=change-me
PHARMACY_APP_PASSWORD=change-me
PHARMACY_PLATFORM_PASSWORD=change-me
REDIS_PASSWORD=change-me
REDIS_MAXMEMORY=256mb
# Authentication (ADR-0008). `init` replaces `generate-key` with 32 random bytes (base64url).
SESSION_JWT_KEYS=k1:generate-key
SESSION_JWT_ACTIVE_KID=k1
PASSWORD_PEPPERS=1:generate-key
PASSWORD_PEPPER_ACTIVE=1
# Reverse proxy (ADR-0012): HTTPS on *.localhost with Caddy's local CA — trust its root once (CLAUDE.md, "Environments").
# The origins below must equal the addresses of the proxy (CSRF Origin check of the API).
PROXY_PROFILE=local
TLS_MODE=internal
PROXY_HTTP_PORT=8080
PROXY_HTTPS_PORT=8443
WEB_ADDR=pharmacy-test.localhost
ADMIN_ADDR=admin.pharmacy-test.localhost
# The addresses that reach the admin host (security review 2026-10-22, A1): locally the clients come from the Docker
# network, hence the private ranges; on a shared stand — the addresses of the testers.
OPERATOR_ALLOW=private_ranges
WEB_ORIGIN=https://pharmacy-test.localhost:8443
ADMIN_ORIGIN=https://admin.pharmacy-test.localhost:8443
# Number of reverse proxies in front of the API: 1 = Caddy (stack.md, question 13). A wrong value lets clients spoof
# X-Forwarded-For (too high) or merges all clients into one rate-limit bucket (too low).
TRUST_PROXY=1
# Backups (ADR-0019): the password of the read-only role pharmacy_backup; `init` replaces change-me.
PHARMACY_BACKUP_PASSWORD=change-me
# Directory of the copies on the host: a separate disk or a network volume, not the Docker data disk; the env file
# (keys, peppers, passwords) is not in the copies and is kept separately. Linux:
#   sudo install -d -o 70 -g 70 -m 700 <dir>   (uid 70 = postgres in the image)
# Docker Desktop on Windows: a host path such as C:/pharmacy-backups/test
BACKUP_DIR=/srv/pharmacy-backups/test
# Daily copy time HH:MM, Asia/Dushanbe; no deploys or manual migrations while a copy runs.
BACKUP_TIME=02:00
BACKUP_RETENTION_DAYS=7
# Copies off the host (ADR-0020, spec 2026-10-23-offsite-backups): every verified copy is encrypted with age for the
# public keys of the keepers and uploaded with rclone to Contabo Object Storage in another region than the VPS. The
# bucket has Object Lock (COMPLIANCE, 30 days) and expires objects after 31 days; the host never deletes there.
# Empty BACKUP_OFFSITE_BUCKET — nothing leaves the host.
BACKUP_OFFSITE_BUCKET=
# Public keys age1… of the two keepers, space-separated (age-keygen on their machines; the private keys never reach
# the server).
BACKUP_AGE_RECIPIENTS=
# rclone remote "offsite" by variables only: type s3, provider Ceph, endpoint of the region
# (https://usc1.contabostorage.com or https://sin1.contabostorage.com), the S3 keys, path-style addressing.
# A local check without the cloud: type local and BACKUP_OFFSITE_BUCKET as a directory mounted into the backup service.
RCLONE_CONFIG_OFFSITE_TYPE=s3
RCLONE_CONFIG_OFFSITE_PROVIDER=Ceph
RCLONE_CONFIG_OFFSITE_ENDPOINT=
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
RCLONE_CONFIG_OFFSITE_FORCE_PATH_STYLE=true
