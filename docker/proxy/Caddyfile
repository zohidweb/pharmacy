# Reverse proxy of Pharmacy (ADR-0012): TLS, static web/admin, /api on the same origin.
# One file for every place; the place is chosen by environment variables (docker/env/*.env):
#   PROXY_PROFILE  cloud (web, admin, apex redirect) | local (web, admin) | offline (http://localhost, web only)
#   TLS_MODE       acme (Let's Encrypt, ACME_EMAIL) | internal (Caddy's local CA, *.localhost) |
#                  files (/certs/cert.pem, /certs/key.pem) | off (plain http:// addresses)
#   WEB_ADDR, ADMIN_ADDR, APEX_ADDR, WEB_ORIGIN, PROXY_HTTP_PORT, PROXY_HTTPS_PORT, API_UPSTREAM
# {$VAR} is substituted before the file is parsed.
{
	# configuration changes = new image or restart (ADR-0012)
	admin off
	http_port {$PROXY_HTTP_PORT:80}
	https_port {$PROXY_HTTPS_PORT:443}
	servers {
		# Caddy has no server timeouts by default: slow clients would hold connections forever.
		timeouts {
			read_header 10s
			read_body 60s
			write 120s
			idle 2m
		}
	}
}

(tls-acme) {
	tls {$ACME_EMAIL}
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

(tls-files) {
	tls /certs/cert.pem /certs/key.pem
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

(tls-internal) {
	tls internal
}

(tls-off) {
}

(access-log) {
	# Cookie, Set-Cookie and Authorization are redacted by Caddy; query strings carry no secrets (ADR-0008).
	log {
		output stdout
		format json
	}
}

# Upstream of the API with the timeouts of ADR-0012; args[0] — response header timeout.
(upstream) {
	reverse_proxy {$API_UPSTREAM:api:3000} {
		transport http {
			dial_timeout 5s
			response_header_timeout {args[0]}
		}
	}
}

# The API of tenant employees and offline stores. The operator contour lives on the admin host only
# (an echelon; the API checks the contour itself).
(api-tenant) {
	@operator path /api/v1/operator /api/v1/operator/*
	handle @operator {
		respond 404
	}
	# offline store batches: up to 2 MB of JSON after gzip, checked by the API body parser (ADR-0014)
	handle /api/v1/sync/* {
		request_body {
			max_size 4MB
		}
		encode zstd gzip
		import upstream 120s
	}
	# data import from a file (spec 2026-10-20-data-import, F19)
	@imports path_regexp ^/api/v1/(catalog|opening-balance|supplier)-imports(/checks)?/?$
	handle @imports {
		request_body {
			max_size 10MB
		}
		encode zstd gzip
		import upstream 120s
	}
	handle /api/* {
		request_body {
			max_size 1MB
		}
		encode zstd gzip
		import upstream 30s
	}
}

# The admin host passes the operator contour only.
(api-operator) {
	@operator path /api/v1/operator /api/v1/operator/*
	handle @operator {
		request_body {
			max_size 1MB
		}
		encode zstd gzip
		import upstream 30s
	}
	handle /api/* {
		respond 404
	}
}

# Static export of Next.js: every route is its own HTML, no SPA fallback (ADR-0012).
# Inline scripts are allowed until build-time hashes (RSC payload of Next, ADR-0012 «Принятие», 4).
(static) {
	handle {
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			Cross-Origin-Opener-Policy same-origin
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
		}
		header /_next/static/* Cache-Control "public, max-age=31536000, immutable"
		header ?Cache-Control "no-cache"
		# trailingSlash is false in the export: /stock/ → /stock instead of a 404
		@trailing path_regexp trailing ^(.+)/$
		redir @trailing {re.trailing.1}{?query} 308
		try_files {path} {path}.html {path}/index.html
		file_server {
			precompressed br gzip
		}
	}
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}

(web-site) {
	import tls-{$TLS_MODE}
	import access-log
	root * /srv/web
	import api-tenant
	import static
}

(admin-site) {
	import tls-{$TLS_MODE}
	import access-log
	root * /srv/admin
	import api-operator
	import static
}

# Container health (Dockerfile HEALTHCHECK); not published.
http://:8081 {
	respond /healthz 200
	respond 404
}

import /etc/caddy/profiles/{$PROXY_PROFILE}.caddy
