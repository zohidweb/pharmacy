#!/bin/sh
# pharmacy-secrets init | check — the secret files of a test or prod environment (ADR-0021,
# docs/superpowers/specs/2026-10-27-secret-store-design.md, K8). The directory is SECRETS_DIR of the env file, mounted at
# /s by the tool service `secrets` of docker/compose.secrets.yml; the same command works on a developer machine and on
# the VPS, which has no Node:
#   docker compose … --profile tools run --rm secrets init
#
#   init   creates the missing files with random values and never overwrites one: passwords — 24 random bytes, the key
#          rings — k1: and 1: with 32 random bytes (base64url), offsite_secret_access_key — empty (nothing leaves the
#          host until the S3 key is written there). redis_users_acl is rebuilt from redis_password whenever it differs:
#          Redis keeps only the SHA-256 of its password. New files are 0444 and belong to the owner of the directory.
#   check  every file is there and single-line, no placeholder of the old env examples, passwords of 16 characters or
#          more, non-empty key rings, redis_users_acl in step with redis_password.
#
# Values are never printed, only file names.
set -eu
umask 077

DIR=/s
PASSWORDS='postgres_superuser_password pharmacy_owner_password pharmacy_app_password pharmacy_platform_password
pharmacy_backup_password redis_password'
RINGS='session_jwt_keys password_peppers'
MIN_PASSWORD_LENGTH=16

die() { echo "pharmacy-secrets: $*" >&2; exit 1; }

# random <bytes> — base64url without padding
random() { head -c "$1" /dev/urandom | base64 | tr '+/' '-_' | tr -d '=\n'; }

# The ACL of the default user of Redis: the SHA-256 of redis_password, never the password itself.
acl_line() {
  printf 'user default on #%s ~* &* +@all' "$(printf '%s' "$(cat "$DIR/redis_password")" | sha256sum | cut -d' ' -f1)"
}

# put <file> <value> — written beside its place, 0444, owned like the directory (the deploy user, not root, on a Linux
# host), then moved in. The value stays in this shell: printf is a builtin.
put() {
  printf '%s' "$2" >"$DIR/.$1.tmp"
  chmod 0444 "$DIR/.$1.tmp"
  [ "$OWNER" = 0:0 ] || chown "$OWNER" "$DIR/.$1.tmp"
  mv -f "$DIR/.$1.tmp" "$DIR/$1"
}

cmd_init() {
  created=''
  for f in $PASSWORDS; do
    [ -e "$DIR/$f" ] || { put "$f" "$(random 24)"; created="$created $f"; }
  done
  [ -e "$DIR/session_jwt_keys" ] || { put session_jwt_keys "k1:$(random 32)"; created="$created session_jwt_keys"; }
  [ -e "$DIR/password_peppers" ] || { put password_peppers "1:$(random 32)"; created="$created password_peppers"; }
  [ -e "$DIR/offsite_secret_access_key" ] ||
    { put offsite_secret_access_key ''; created="$created offsite_secret_access_key"; }
  acl=$(acl_line)
  if [ ! -e "$DIR/redis_users_acl" ] || [ "$(cat "$DIR/redis_users_acl")" != "$acl" ]; then
    put redis_users_acl "$acl"
    created="$created redis_users_acl"
  fi
  echo "secrets: written:${created:- nothing, every file is in place}"
}

cmd_check() {
  bad=0
  problem() { echo "  $1" >&2; bad=1; }
  for f in $PASSWORDS $RINGS offsite_secret_access_key redis_users_acl; do
    if [ ! -f "$DIR/$f" ]; then
      problem "$f: missing — run init"
      continue
    fi
    [ "$(($(tr -d '\r\n' <"$DIR/$f" | wc -c)))" = "$(($(wc -c <"$DIR/$f")))" ] ||
      problem "$f: holds a line break — write it with printf '%s', not echo or an editor"
    ! grep -q -e change-me -e generate-key "$DIR/$f" || problem "$f: holds a placeholder of the old env examples"
  done
  for f in $PASSWORDS; do
    [ ! -f "$DIR/$f" ] || [ "$(($(wc -c <"$DIR/$f")))" -ge "$MIN_PASSWORD_LENGTH" ] ||
      problem "$f: shorter than $MIN_PASSWORD_LENGTH characters"
  done
  for f in $RINGS; do
    [ ! -f "$DIR/$f" ] || [ -s "$DIR/$f" ] || problem "$f: empty"
  done
  if [ -f "$DIR/redis_password" ] && [ -f "$DIR/redis_users_acl" ] &&
    [ "$(cat "$DIR/redis_users_acl")" != "$(acl_line)" ]; then
    problem "redis_users_acl: does not match redis_password — run init"
  fi
  [ "$bad" = 0 ] || die "the secrets in $DIR are not ready (above)"
  echo "secrets: ok"
}

[ -d "$DIR" ] || die "$DIR is not mounted (SECRETS_DIR of the env file)"
OWNER=$(stat -c %u:%g "$DIR")
# The directory keeps the files from the other users of the host: 0700 (K1). One that Docker made on its own is root's
# and 0755. Docker Desktop shows every directory of the host as 0777: its file sharing decides access there.
MODE=$(stat -c %a "$DIR")
case "$MODE" in
700 | 777) ;;
*) die "SECRETS_DIR has the mode $MODE: other users of the host could read the secrets — chmod 700 it, owned by the deploy user" ;;
esac
case "${1:-}" in
init) cmd_init ;;
check) cmd_check ;;
*) echo "usage: pharmacy-secrets init | check" >&2; exit 2 ;;
esac
