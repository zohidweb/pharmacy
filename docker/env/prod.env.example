# prod environment. Copy to docker/env/prod.env (never commit it) or run: npm run stack -- prod init
# Placeholders are replaced with random values by `init`. Until an ADR selects a secret store
# (stack.md, question 8) this file lives only on the prod host, readable by its operator only.
APP_ENV=prod
POSTGRES_DB=pharmacy
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me
PHARMACY_OWNER_PASSWORD=change-me
PHARMACY_APP_PASSWORD=change-me
PHARMACY_PLATFORM_PASSWORD=change-me
REDIS_PASSWORD=change-me
REDIS_MAXMEMORY=768mb
# Authentication (ADR-0008). `init` replaces `generate-key` with 32 random bytes (base64url).
SESSION_JWT_KEYS=k1:generate-key
SESSION_JWT_ACTIVE_KID=k1
PASSWORD_PEPPERS=1:generate-key
PASSWORD_PEPPER_ACTIVE=1
# Reverse proxy and hosting (ADR-0012, ADR-0020): Let's Encrypt for nurmed.online. DNS A records of app., admin. and the
# apex must point to the VPS before the first start, and port 80 must be open — or the certificate is not issued.
PROXY_PROFILE=cloud
TLS_MODE=acme
# Let's Encrypt account (expiry notices). Required.
ACME_EMAIL=
PROXY_BIND_ADDR=0.0.0.0
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
WEB_ADDR=app.nurmed.online
ADMIN_ADDR=admin.nurmed.online
# The addresses that reach admin.nurmed.online, the operator admin and /api/v1/operator/* (security review 2026-10-22,
# A1): the public IPs of the operator offices or of the VPN, CIDR, space-separated, e.g. 203.0.113.10/32 198.51.100.0/28.
# Required; others get 403.
OPERATOR_ALLOW=
APEX_ADDR=nurmed.online
# Origins of the web apps (CSRF Origin check of the API) — the same hosts over https, no port.
WEB_ORIGIN=https://app.nurmed.online
ADMIN_ORIGIN=https://admin.nurmed.online
# Number of reverse proxies in front of the API: 1 = Caddy (stack.md, question 13; decision 7.2 of the security review
# 2026-10-22). The API refuses to start in prod with 0 or with http:// origins. A wrong value lets clients spoof
# X-Forwarded-For (too high) or merges all clients into one rate-limit bucket (too low).
TRUST_PROXY=1
# Backups (ADR-0019): the password of the read-only role pharmacy_backup; `init` replaces change-me.
PHARMACY_BACKUP_PASSWORD=change-me
# Directory of the copies on the host: a separate disk or a network volume, not the Docker data disk; the env file
# (keys, peppers, passwords) is not in the copies and is kept separately. Linux:
#   sudo install -d -o 70 -g 70 -m 700 <dir>   (uid 70 = postgres in the image)
# Docker Desktop on Windows: a host path such as C:/pharmacy-backups/prod
BACKUP_DIR=/srv/pharmacy-backups/prod
# Daily copy time HH:MM, Asia/Dushanbe; no deploys or manual migrations while a copy runs.
BACKUP_TIME=02:00
BACKUP_RETENTION_DAYS=30
