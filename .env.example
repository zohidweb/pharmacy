# Copy to .env (never commit .env). Values below are placeholders for local development only.

# apps/api (when run with `npx nx serve api`).
# Do not set NODE_ENV here: Nx loads this file into every task and `next build` fails in
# development mode. apps/api defaults to development; Docker sets production explicitly.
PORT=3000

# Next.js anonymous telemetry off: no data to external SaaS (project rule, ADR-0011; ADR-0009)
NEXT_TELEMETRY_DISABLED=1

# docker (npm run stack -- dev …) — local PostgreSQL / Redis / API container
APP_ENV=dev
API_PORT=3000
POSTGRES_DB=pharmacy
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-local-only
PHARMACY_OWNER_PASSWORD=change-me-local-only
PHARMACY_APP_PASSWORD=change-me-local-only
PHARMACY_PLATFORM_PASSWORD=change-me-local-only
REDIS_PASSWORD=change-me-local-only

# apps/api outside Docker (npx nx serve api) and migrations — PostgreSQL from `npm run dev:deps` on 127.0.0.1:5432.
# Passwords must match the PHARMACY_*_PASSWORD values above.
DATABASE_URL=postgres://pharmacy_app:change-me-local-only@127.0.0.1:5432/pharmacy
PLATFORM_DATABASE_URL=postgres://pharmacy_platform:change-me-local-only@127.0.0.1:5432/pharmacy
MIGRATION_DATABASE_URL=postgres://pharmacy_owner:change-me-local-only@127.0.0.1:5432/pharmacy
# Integration tests run against this empty database (created by initdb in dev, see compose.dev.yml)
TEST_DATABASE_NAME=pharmacy_test
REDIS_URL=redis://:change-me-local-only@127.0.0.1:6379

# apps/web, apps/admin dev server: where /api/* is proxied (next.config.js rewrites, dev only)
# API_PROXY_TARGET=http://localhost:3000

# Authentication (ADR-0008, docs/superpowers/specs/2026-10-02-auth-design.md, section 11). apps/api refuses to start
# without these. Keys are `id:base64url` lists, >= 32 bytes each. The values below are public dev-only placeholders:
# generate your own with `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`.
SESSION_JWT_KEYS=k1:ZGV2LW9ubHktcGxhY2Vob2xkZXItbm90LWEtc2VjcmV0LWtleQ
SESSION_JWT_ACTIVE_KID=k1
PASSWORD_PEPPERS=1:ZGV2LW9ubHktcGVwcGVyLXBsYWNlaG9sZGVyLW5vdC1hLXNlY3JldA
PASSWORD_PEPPER_ACTIVE=1
# Origins of the web apps (CSRF Origin check): scheme://host[:port], no path.
WEB_ORIGIN=http://localhost:4200
ADMIN_ORIGIN=http://localhost:4300
# Optional (defaults in parentheses): STORE_MODE (cloud), SESSION_IDLE_TIMEOUT_MIN_SECONDS (300),
# SESSION_IDLE_TIMEOUT_MAX_SECONDS (43200), SESSION_ABSOLUTE_TTL_SECONDS (43200), STEP_UP_MAX_AGE_SECONDS (900),
# LOGIN_MAX_FAILURES (5), LOGIN_LOCK_SECONDS (900), ACTIVATION_CODE_TTL_HOURS (72).
# e2e only; the process refuses to start with true unless APP_ENV=test: AUTH_TEST_COOKIES=false
