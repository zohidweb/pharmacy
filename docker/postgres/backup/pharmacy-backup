#!/bin/sh
# pharmacy-backup — daily copies of the cloud database, each verified by a restore (ADR-0019,
# docs/superpowers/specs/2026-10-21-db-backups-design.md).
#
#   daemon                 copy every day at BACKUP_TIME (TZ), at once when the newest verified copy started before
#                          the last BACKUP_TIME that has passed (a missed or interrupted copy); a failed copy is
#                          retried in an hour (container `backup`)
#   run                    one copy now; exit 0 verified, 1 failed, 2 refused (BACKUP_ROOT not writable or the
#                          empty-database guard), 3 a copy is already running
#   verify <name>          restore an existing copy into a scratch instance again and compare it with its manifest
#   status                 the copies, the newest verified one, the next run, the reason of a block
#   health                 exit 0 healthy, 1 unhealthy (container healthcheck)
#   restore <name> [--check]
#                          container `postgres`, superuser over the local socket: restore the copy beside the working
#                          database and swap the names; --check only validates and prints the plan
#   push                   upload the verified copies not yet off the host (`run` and the daemon do it themselves)
#   list-offsite [--at <time>]
#                          the copies and the env files in the bucket for APP_ENV, with their older versions
#   fetch <name> [--at <time>]
#                          the server is lost: download the copy, decrypt it with the private key of a keeper read from
#                          stdin (never stored) and put it into BACKUP_ROOT for `restore`
#   verify-offsite <name> [--at <time>]
#                          the monthly drill: download, decrypt (key on stdin), restore into a scratch instance, compare
#   env-push               the tar of the env file and the secret files of the environment from stdin, encrypted for
#                          the keepers, into the bucket
#   env-open <archive> <dir>
#                          the server is lost: an archive of env-push, decrypted with the private key of a keeper read
#                          from stdin, into <dir> — only the env file and the secret files, checked first
#
# Copies off the host (ADR-0020, docs/superpowers/specs/2026-10-23-offsite-backups-design.md): a verified copy is
# encrypted with age for BACKUP_AGE_RECIPIENTS and uploaded with rclone (remote `offsite`, RCLONE_CONFIG_OFFSITE_*) as
# <BACKUP_OFFSITE_BUCKET>/<APP_ENV>/<name>.tar.age; nothing is ever deleted there (Object Lock and the lifecycle rules
# of the bucket keep the copies 30 days). Object Lock keeps every version, but whoever holds the bucket key can put a
# newer version or a delete marker over it: after a break-in the copies are read as they were before it (--at <UTC
# time>, by the time the storage wrote each version, whatever the name).
#
# Environment: BACKUP_ROOT (/backups), SCRATCH (/scratch), BACKUP_TIME (02:00), BACKUP_RETENTION_DAYS (30), TZ,
# IMAGE_TAG, APP_ENV, BACKUP_OFFSITE_BUCKET, BACKUP_AGE_RECIPIENTS; `run` connects with PGHOST, PGPORT, PGUSER,
# PGPASSWORD, PGDATABASE (role pharmacy_backup); `restore` with POSTGRES_USER and POSTGRES_DB of the postgres
# container. Passwords and keys are never logged. In test and prod the secrets come from files (compose secrets,
# ADR-0021): PGPASSWORD_FILE and RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY_FILE (an empty file — no key) of the backup
# service, POSTGRES_PASSWORD_FILE of the postgres container for `restore`.
set -u
umask 077
# Notices such as "role … has already been granted membership" are expected when roles are re-applied.
export PGOPTIONS="${PGOPTIONS:-} -c client_min_messages=warning"

BACKUP_ROOT=${BACKUP_ROOT:-/backups}
SCRATCH=${SCRATCH:-/scratch}
BACKUP_TIME=${BACKUP_TIME:-02:00}
RETENTION_DAYS=${BACKUP_RETENTION_DAYS:-30}
DB_NAME=${PGDATABASE:-pharmacy}
STATE="$BACKUP_ROOT/.state"
# On the shared volume, not in /tmp: fetch and verify-offsite run in their own container (`compose run`) beside the
# daemon, and both use $SCRATCH; flock on one file of a volume holds across the containers of the host.
LOCK="$SCRATCH/.pharmacy-backup.lock"
STARTED=/tmp/pharmacy-backup.started
TMP_BLOCKED=/tmp/pharmacy-backup.blocked
SCRATCH_PORT=5499
SCRATCH_CONN="-h $SCRATCH -p $SCRATCH_PORT -U postgres"
HEALTHY_AGE=$((26 * 3600))
GRACE=$((2 * 3600))
RETRY=3600
TABLES_SQL="select count(*) from pg_class c join pg_namespace n on n.oid = c.relnamespace
  where n.nspname in ('pharmacy', 'public') and c.relkind in ('r', 'p')"
c_error=''
s_error=''

log() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"; }
die() { log "ERROR: $*" >&2; exit 1; }

# A bad value would surface only after a copy is taken (an arithmetic error in the retention).
check_retention() {
  case "$RETENTION_DAYS" in
  '' | *[!0-9]*) die "BACKUP_RETENTION_DAYS must be a whole number of days, got '$RETENTION_DAYS'" ;;
  esac
}

# One line, no quotes or backslashes: the value goes into the JSON manifest as is.
sanitize() { printf '%s' "$1" | tr -d '"\\' | tr '\n\r\t' '   ' | cut -c1-500; }

is_name() { printf '%s' "$1" | grep -q '^[0-9]\{8\}T[0-9]\{6\}Z$'; }

# take_lock — the copy lock (exit 3 when a copy is already running). Under it whatever a run left in $SCRATCH is stale:
# an interrupted fetch or drill must not keep the decrypted copy there. A signal ends the run through its EXIT trap.
take_lock() {
  # A failed redirection of `exec` would end the shell with a bare message.
  (: >>"$LOCK") 2>/dev/null || die "$SCRATCH is not writable by uid $(id -u): the copy lock cannot be taken"
  exec 9>>"$LOCK"
  flock -n 9 || { log "a copy is already running"; exit 3; }
  trap 'exit 1' INT TERM HUP
  rm -rf "$SCRATCH"/*.tar "$SCRATCH"/*.tar.age "$SCRATCH"/*.check 2>/dev/null
}

# at_option [--at <time>] — AT: rclone reads the objects of the bucket as they were at that UTC time (S3 versions).
at_option() {
  AT=''
  [ -z "${1:-}" ] && return 0
  [ "$1" = --at ] || die "unknown option $1"
  printf '%s' "${2:-}" | grep -q '^[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}T[0-9]\{2\}:[0-9]\{2\}:[0-9]\{2\}Z$' ||
    die "--at takes a UTC time such as 2026-10-20T21:00:00Z"
  AT=$2
  export RCLONE_S3_VERSION_AT="$AT"
}
name_epoch() { date -u -D '%Y%m%dT%H%M%SZ' -d "$1" +%s; }
local_time() { date -d "@$1" '+%Y-%m-%d %H:%M'; }

# Manifests hold one `"key": value` pair per line, so sed reads them.
manifest_get() { sed -n "s/^  \"$2\": //p" "$1" 2>/dev/null | head -n 1 | sed 's/,$//; s/^"//; s/"$//'; }

# q <conn> <db> <sql> — one value; <conn> is empty for the PG* environment.
# shellcheck disable=SC2086
q() { psql -X -A -t -q -v ON_ERROR_STOP=1 $1 -d "$2" -c "$3"; }

# db_facts <conn> <db> — f_tables, f_migration (empty without pgmigrations), f_tenants (0 without the table).
db_facts() {
  f_tables=$(q "$1" "$2" "$TABLES_SQL") || return 1
  f_migration=''
  has=$(q "$1" "$2" "select to_regclass('public.pgmigrations') is not null") || return 1
  if [ "$has" = t ]; then
    f_migration=$(q "$1" "$2" "select name from public.pgmigrations order by id desc limit 1") || return 1
  fi
  f_tenants=0
  has=$(q "$1" "$2" "select to_regclass('pharmacy.tenants') is not null") || return 1
  if [ "$has" = t ]; then
    f_tenants=$(q "$1" "$2" "select count(*) from pharmacy.tenants") || return 1
  fi
}

copy_names() {
  for d in "$BACKUP_ROOT"/*; do
    n=${d##*/}
    is_name "$n" && printf '%s\n' "$n"
  done
}

newest_verified() {
  newest=''
  for n in $(copy_names); do
    [ "$(manifest_get "$BACKUP_ROOT/$n/manifest.json" verified)" = true ] && newest=$n
  done
  printf '%s' "$newest"
}

verified_with_tenants() {
  for n in $(copy_names); do
    m="$BACKUP_ROOT/$n/manifest.json"
    [ "$(manifest_get "$m" verified)" = true ] || continue
    [ "$(manifest_get "$m" tenants)" -gt 0 ] 2>/dev/null && return 0
  done
  return 1
}

block() {
  log "BLOCKED: $1"
  { printf '%s\n' "$1" >"$STATE/blocked"; } 2>/dev/null || printf '%s\n' "$1" >"$TMP_BLOCKED"
}

unblock() { rm -f "$STATE/blocked" "$TMP_BLOCKED"; }

# preflight — 0 ready, 1 the source database cannot be read (psql errors in /tmp/pharmacy-backup.err), 2 refused:
# BACKUP_ROOT is not writable (B16) or the database has no networks while verified copies have them (B15).
preflight() {
  if ! mkdir -p "$STATE" 2>/dev/null || ! { : >"$STATE/.probe"; } 2>/dev/null; then
    block "BACKUP_ROOT $BACKUP_ROOT is not writable by uid $(id -u); on a Linux host create BACKUP_DIR with: sudo install -d -o 70 -g 70 -m 700 <BACKUP_DIR>"
    return 2
  fi
  rm -f "$STATE/.probe"
  db_facts "" "$DB_NAME" 2>/tmp/pharmacy-backup.err || return 1
  if [ "$f_tenants" = 0 ] && verified_with_tenants; then
    block "the database has no networks while verified copies have them (data loss?): no copy is taken; restore the database with: npm run stack -- <env> restore <copy> --replace-database"
    return 2
  fi
  unblock
  return 0
}

scratch_stop() {
  # Only a live postmaster of this container is stopped: after a container restart the pid file in the volume is
  # stale and its number may belong to another process.
  pid=$(head -n 1 "$SCRATCH/data/postmaster.pid" 2>/dev/null)
  if [ -n "$pid" ] && [ "$(cat "/proc/$pid/comm" 2>/dev/null)" = postgres ]; then
    pg_ctl -D "$SCRATCH/data" -m fast -w stop >/dev/null 2>&1
  fi
  rm -rf "$SCRATCH/data" "$SCRATCH/initdb.log" "$SCRATCH/server.log" 2>/dev/null
}

# A throwaway instance on a unix socket only; durability is off, the data is deleted afterwards. The postmaster gets
# no lock descriptor (9>&-): if the run is killed, an orphaned instance must not keep the copy lock.
scratch_start() {
  scratch_stop
  if ! [ -w "$SCRATCH" ]; then
    s_error="$SCRATCH is not writable by uid $(id -u)"
    return 1
  fi
  if ! initdb -D "$SCRATCH/data" -U postgres --auth=trust >"$SCRATCH/initdb.log" 2>&1 9>&- ||
    ! pg_ctl -D "$SCRATCH/data" -l "$SCRATCH/server.log" -w -t 120 -o "-c listen_addresses='' \
-c unix_socket_directories=$SCRATCH -p $SCRATCH_PORT -c fsync=off -c full_page_writes=off \
-c synchronous_commit=off -c max_parallel_maintenance_workers=0" start >/dev/null 2>&1 9>&-; then
    s_error=$(tail -n 2 "$SCRATCH/initdb.log" "$SCRATCH/server.log" 2>/dev/null)
    return 1
  fi
}

# apply_globals <conn> <globals.sql> — the roles of the copy, without passwords. A missing role is created, an
# existing one keeps its password; lines of the superuser role postgres are skipped. Plain SQL only: the dump is
# wrapped in \restrict, which forbids psql meta-commands such as \gexec.
# shellcheck disable=SC2086
apply_globals() {
  grep -v -E '^(CREATE|ALTER) ROLE postgres( |;)' "$2" |
    sed -E 's/^CREATE ROLE ([a-z_][a-z0-9_]*);$/DO $$BEGIN CREATE ROLE \1; EXCEPTION WHEN duplicate_object THEN NULL; END$$;/' |
    psql -X -q -v ON_ERROR_STOP=1 $1 -d postgres >/dev/null
}

# restore_into <conn> <db> <dump> — the procedure of a real restore (spec B9): an empty database owned by
# pharmacy_owner, then pg_restore.
# shellcheck disable=SC2086
restore_into() {
  psql -X -q -v ON_ERROR_STOP=1 $1 -d postgres -c "create database \"$2\" owner pharmacy_owner" &&
    pg_restore $1 -j 2 --exit-on-error -d "$2" "$3"
}

# dump_facts <dump> — d_tables, d_migration of the copy itself, from its table of contents and its pgmigrations
# data: the snapshot of the copy. A query of the live database before or after pg_dump would race with DDL (a
# migration committed in between) and fail a sound copy or pass a broken one.
dump_facts() {
  toc=$(pg_restore -l "$1") || return 1
  d_tables=$(printf '%s\n' "$toc" | grep -c -E '^[0-9]+; [0-9]+ [0-9]+ TABLE (pharmacy|public) ')
  # pg_restore apart from awk: in a pipeline its failure would be lost and surface as a wrong "last migration".
  migrations=$(pg_restore -a -n public -t pgmigrations -f - "$1") || return 1
  d_migration=$(printf '%s\n' "$migrations" | awk -F '\t' '
    /^COPY public\.pgmigrations / { data = 1; next }
    data && /^\\\.$/ { data = 0 }
    data && $1 + 0 > max { max = $1 + 0; name = $2 }
    END { print name }')
}

# check_restored <conn> <db> <tables> <migration> — c_tenants, or c_error.
check_restored() {
  db_facts "$1" "$2" || { c_error="the restored database cannot be read"; return 1; }
  [ "$f_tables" = "$3" ] || { c_error="tables: restored $f_tables, source $3"; return 1; }
  [ "$f_migration" = "$4" ] || { c_error="last migration: restored '$f_migration', source '$4'"; return 1; }
  c_tenants=$f_tenants
}

write_manifest() {
  {
    printf '{\n'
    printf '  "name": "%s",\n' "$m_name"
    printf '  "startedEpoch": %s,\n' "$m_started"
    printf '  "startedAt": "%s",\n' "$(date -u -d "@$m_started" +%Y-%m-%dT%H:%M:%SZ)"
    printf '  "finishedEpoch": %s,\n' "$m_finished"
    printf '  "finishedAt": "%s",\n' "$(date -u -d "@$m_finished" +%Y-%m-%dT%H:%M:%SZ)"
    printf '  "imageTag": "%s",\n' "$(sanitize "${IMAGE_TAG:-unknown}")"
    printf '  "serverVersion": "%s",\n' "$(sanitize "$m_server")"
    printf '  "dumpBytes": %s,\n' "${m_bytes:-0}"
    printf '  "dumpSeconds": %s,\n' "${m_dump_s:-0}"
    printf '  "restoreSeconds": %s,\n' "${m_restore_s:-0}"
    printf '  "tables": %s,\n' "${m_tables:-0}"
    printf '  "lastMigration": "%s",\n' "$(sanitize "$m_migration")"
    printf '  "tenants": %s,\n' "${m_tenants:-0}"
    printf '  "verified": %s,\n' "$m_verified"
    printf '  "error": "%s"\n' "$(sanitize "$m_error")"
    printf '}\n'
  } >"$1"
}

retention() {
  now=$(date +%s)
  keep=$(newest_verified)
  limit=$((now - RETENTION_DAYS * 86400))
  for d in "$BACKUP_ROOT"/*; do
    n=${d##*/}
    case "$n" in
    *.failed)
      is_name "${n%.failed}" || continue
      [ "$(name_epoch "${n%.failed}")" -lt $((now - 86400)) ] || continue
      ;;
    *)
      is_name "$n" || continue
      [ "$n" != "$keep" ] || continue
      [ "$(manifest_get "$d/manifest.json" verified)" = true ] || continue
      [ "$(name_epoch "$n")" -lt "$limit" ] || continue
      ;;
    esac
    rm -rf "$d" && log "removed $n (older than the retention period)"
  done
}

# --- Copies off the host --------------------------------------------------------------------------------------------

offsite_enabled() { [ -n "${BACKUP_OFFSITE_BUCKET:-}" ]; }

# The objects of the environment: copies <prefix>/<name>.tar.age, the env file with the secrets
# <prefix>/env/<time>.tar.age.
offsite_prefix() { printf 'offsite:%s/%s' "$BACKUP_OFFSITE_BUCKET" "${APP_ENV:-unknown}"; }
offsite_object() { printf '%s/%s.tar.age' "$(offsite_prefix)" "$1"; }

# The last outcome of the uploads, for `status`: it runs in the postgres container, without the upload variables.
offsite_state() { { printf '%s\n' "$1" >"$STATE/offsite"; } 2>/dev/null; }

# age_recipients — the -r options of BACKUP_AGE_RECIPIENTS; fails unless every key is a public key age1….
age_recipients() {
  # shellcheck disable=SC2086
  set -- ${BACKUP_AGE_RECIPIENTS:-}
  [ $# -gt 0 ] || return 1
  recipients=''
  for r in "$@"; do
    case "$r" in
    age1*) recipients="$recipients -r $r" ;;
    *) return 1 ;;
    esac
  done
  printf '%s' "$recipients"
}

# offsite_size <object> — its size in bytes; empty when there is no such object.
offsite_size() { rclone size --json "$1" 2>/dev/null | sed -n 's/.*"bytes":\([0-9]*\).*/\1/p'; }

# offsite_upload <name> — encrypt and upload one verified copy, then write <copy>/offsite.json. An object of the same
# size is the same copy uploaded before (an interrupted run; age and tar give the same size for the same files): it
# counts as uploaded, a second upload would only add a version. o_error and o_bytes for the caller.
offsite_upload() {
  dir="$BACKUP_ROOT/$1"
  obj=$(offsite_object "$1")
  tmp="$SCRATCH/$1.tar.age"
  err=/tmp/pharmacy-backup.offsite.err
  o_error='' o_bytes=''
  recipients=$(age_recipients) || { o_error='BACKUP_AGE_RECIPIENTS must hold public keys age1…, space-separated'; return 1; }
  rm -f "$tmp"
  # shellcheck disable=SC2086
  if ! (set -o pipefail; tar -C "$dir" -cf - pharmacy.dump globals.sql manifest.json | age $recipients -o "$tmp") 2>"$err"; then
    rm -f "$tmp"
    o_error="encryption failed: $(sanitize "$(tail -n 1 "$err")" | cut -c1-200)"
    return 1
  fi
  o_bytes=$(stat -c %s "$tmp")
  if [ "$(offsite_size "$obj")" != "$o_bytes" ]; then
    if ! rclone copyto "$tmp" "$obj" 2>"$err"; then
      rm -f "$tmp"
      o_error="upload failed: $(sanitize "$(tail -n 1 "$err")" | cut -c1-200)"
      return 1
    fi
    got=$(offsite_size "$obj")
    if [ "$got" != "$o_bytes" ]; then
      rm -f "$tmp"
      o_error="the object has ${got:-no} bytes after the upload instead of $o_bytes"
      return 1
    fi
  fi
  rm -f "$tmp"
  now=$(date +%s)
  {
    printf '{\n'
    printf '  "object": "%s",\n' "$(sanitize "${obj#offsite:}")"
    printf '  "bytes": %s,\n' "$o_bytes"
    printf '  "uploadedEpoch": %s,\n' "$now"
    printf '  "uploadedAt": "%s"\n' "$(date -u -d "@$now" +%Y-%m-%dT%H:%M:%SZ)"
    printf '}\n'
  } >"$dir/offsite.json"
}

# offsite_push — under the copy lock: the verified copies younger than the retention period without offsite.json,
# the newest first; stops at the first failure (the storage is usually down for all of them). 0 — all uploaded.
offsite_push() {
  if ! offsite_enabled; then
    offsite_state disabled
    return 0
  fi
  limit=$(($(date +%s) - RETENTION_DAYS * 86400))
  pending=''
  for n in $(copy_names); do
    [ "$(manifest_get "$BACKUP_ROOT/$n/manifest.json" verified)" = true ] || continue
    [ -f "$BACKUP_ROOT/$n/offsite.json" ] && continue
    [ "$(name_epoch "$n")" -ge "$limit" ] || continue
    pending="$n $pending"
  done
  for n in $pending; do
    if ! offsite_upload "$n"; then
      log "offsite $n: NOT uploaded — $o_error"
      offsite_state "error $(date -u +%Y-%m-%dT%H:%M:%SZ) $o_error"
      return 1
    fi
    log "offsite $n: uploaded — $((o_bytes / 1048576)) MB"
  done
  offsite_state "configured $BACKUP_OFFSITE_BUCKET"
  return 0
}

# The newest upload: "<epoch> <name>", empty without one.
newest_offsite() {
  newest=''
  for n in $(copy_names); do
    e=$(manifest_get "$BACKUP_ROOT/$n/offsite.json" uploadedEpoch)
    [ -n "$e" ] && newest="$e $n"
  done
  printf '%s' "$newest"
}

cmd_push() {
  offsite_enabled || die "copies off the host are not configured (BACKUP_OFFSITE_BUCKET is empty)"
  check_retention
  take_lock
  offsite_push
}

# list-offsite [--at <time>] — the objects of the environment; without --at with their older versions (<name>-v<time
# written>): a copy or an env file written again is the sign of someone else with the bucket key.
cmd_list_offsite() {
  offsite_enabled || die "copies off the host are not configured (BACKUP_OFFSITE_BUCKET is empty)"
  at_option "$@"
  err=/tmp/pharmacy-backup.offsite.err
  versions=--s3-versions
  [ -n "$AT" ] && versions=''
  # An empty prefix (nothing uploaded yet) is "directory not found"; any other error is not an empty bucket.
  # shellcheck disable=SC2086
  if ! objects=$(rclone lsf -R --files-only $versions "$(offsite_prefix)/" 2>"$err"); then
    grep -q 'directory not found' "$err" ||
      die "list-offsite: the bucket cannot be read: $(sanitize "$(tail -n 1 "$err")" | cut -c1-200)"
    objects=''
  fi
  printf 'copies in %s%s:\n' "${BACKUP_OFFSITE_BUCKET}/${APP_ENV:-unknown}" "${AT:+ as of $AT}"
  printf '%s\n' "$objects" | grep -v -e '^env/' -e '^$' | sed 's/\.tar\.age$//' | sort | sed 's/^/  /'
  printf 'env files:\n'
  printf '%s\n' "$objects" | sed -n 's/^env\///p' | sort | sed 's/^/  /'
  if printf '%s\n' "$objects" | grep -q -- '-v[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}-'; then
    printf 'an object with -v<time> is an older version: it was written again; after a break-in read the copies and the\n'
    printf 'env file as they were before it (--at <UTC time>, docs/guides/deploy-vps.md)\n'
  fi
}

# offsite_download <name> <dir> — the object of the copy (as of AT), decrypted with the private key of a keeper (KEY),
# into <dir>. Anyone with the bucket key can put an object encrypted for the public keys there, so the archive is
# opened only when it holds exactly the three files of a copy as plain files (no links), and its manifest names this
# copy and says it was verified. f_error for the caller; nothing is left behind on failure.
offsite_download() {
  enc="$SCRATCH/$1.tar.age"
  plain="$SCRATCH/$1.tar"
  err=/tmp/pharmacy-backup.offsite.err
  f_error=''
  rm -rf "$2" "$enc" "$plain"
  if ! rclone copyto "$(offsite_object "$1")" "$enc" 2>"$err"; then
    f_error="download failed: $(sanitize "$(tail -n 1 "$err")" | cut -c1-200)"
  elif ! printf '%s\n' "$KEY" | age -d -i /dev/stdin -o "$plain" "$enc" 2>"$err"; then
    f_error="decryption failed (the private key of a keeper?): $(sanitize "$(tail -n 1 "$err")" | cut -c1-200)"
  elif [ "$(tar -tf "$plain" 2>/dev/null | sort | tr '\n' ' ')" != 'globals.sql manifest.json pharmacy.dump ' ] ||
    tar -tvf "$plain" 2>/dev/null | grep -q -e '^[^-]' -e ' -> '; then
    # busybox tar lists a symbolic link as l…, a hard link as -… <name> -> <target>
    f_error="the archive does not hold exactly pharmacy.dump, globals.sql and manifest.json as plain files"
  elif ! mkdir -p "$2" || ! tar -C "$2" -xf "$plain" pharmacy.dump globals.sql manifest.json 2>"$err"; then
    f_error="unpacking failed: $(sanitize "$(tail -n 1 "$err")" | cut -c1-200)"
  elif [ "$(manifest_get "$2/manifest.json" name)" != "$1" ] ||
    [ "$(manifest_get "$2/manifest.json" verified)" != true ]; then
    f_error="the archive is not the verified copy $1"
  fi
  rm -f "$enc" "$plain"
  [ -z "$f_error" ] && return 0
  rm -rf "$2"
  return 1
}

# fetch_check <command> <name> [--at <time>] — the arguments, the key and the lock shared by fetch and verify-offsite.
# The key is read before the lock: a forgotten `< key.txt` waits here, not holding the lock of the nightly copy.
fetch_check() {
  is_name "${2:-}" || die "usage: pharmacy-backup $1 <copy> [--at <UTC time>] — the private key of a keeper on stdin"
  offsite_enabled || die "copies off the host are not configured (BACKUP_OFFSITE_BUCKET is empty)"
  at_option "${3:-}" "${4:-}"
  [ -t 0 ] && die "$1 $2: the private key of a keeper goes on stdin, it is never stored on this host"
  # In memory only; a key file saved on Windows has CRLF.
  KEY=$(tr -d '\r')
  printf '%s\n' "$KEY" | grep -q '^AGE-SECRET-KEY-1' ||
    die "$1 $2: stdin holds no private key of age (a line AGE-SECRET-KEY-1…)"
  take_lock
}

# fetch <name> [--at <time>] — the server is lost: the copy comes back from the bucket into BACKUP_ROOT, ready for
# `restore`.
cmd_fetch() {
  name=${1:-}
  fetch_check fetch "$@"
  [ -e "$BACKUP_ROOT/$name" ] && die "copy $name is already in $BACKUP_ROOT: nothing to fetch"
  mkdir -p "$STATE" 2>/dev/null || die "BACKUP_ROOT $BACKUP_ROOT is not writable by uid $(id -u)"
  part="$BACKUP_ROOT/$name.partial"
  trap 'rm -rf "$part" "$SCRATCH/$name.tar" "$SCRATCH/$name.tar.age"' EXIT
  offsite_download "$name" "$part" || die "fetch $name: $f_error"
  now=$(date +%s)
  {
    printf '{\n'
    printf '  "object": "%s",\n' "$(sanitize "$(offsite_object "$name" | sed 's/^offsite://')")"
    [ -n "$AT" ] && printf '  "versionAt": "%s",\n' "$AT"
    printf '  "fetchedAt": "%s"\n' "$(date -u -d "@$now" +%Y-%m-%dT%H:%M:%SZ)"
    printf '}\n'
  } >"$part/offsite.json"
  mv "$part" "$BACKUP_ROOT/$name" || die "cannot rename $part"
  log "fetch $name: done, $(manifest_get "$BACKUP_ROOT/$name/manifest.json" tenants) networks — restore it with: restore $name --replace-database"
}

# verify-offsite <name> [--at <time>] — the monthly drill (spec O12): download, decrypt and restore into a scratch
# instance, compare with the manifest of the copy; nothing stays on the host.
cmd_verify_offsite() {
  name=${1:-}
  fetch_check verify-offsite "$@"
  dir="$SCRATCH/$name.check"
  trap 'scratch_stop; rm -rf "$dir" "$SCRATCH/$name.tar" "$SCRATCH/$name.tar.age"' EXIT
  t0=$(date +%s)
  offsite_download "$name" "$dir" || die "verify-offsite $name: $f_error"
  scratch_start || die "verify-offsite $name: the scratch instance did not start: $s_error"
  apply_globals "$SCRATCH_CONN" "$dir/globals.sql" || die "verify-offsite $name: the roles of the copy cannot be applied"
  restore_into "$SCRATCH_CONN" "$DB_NAME" "$dir/pharmacy.dump" || die "verify-offsite $name: pg_restore failed"
  check_restored "$SCRATCH_CONN" "$DB_NAME" "$(manifest_get "$dir/manifest.json" tables)" \
    "$(manifest_get "$dir/manifest.json" lastMigration)" || die "verify-offsite $name: $c_error"
  log "verify-offsite $name: ok — downloaded, decrypted and restored in $(($(date +%s) - t0)) s, $c_tenants networks"
}

# env-push — the tar of the env file and the secret files of the environment from stdin (keys of JWT, peppers,
# passwords; ADR-0008, ADR-0021), encrypted for the keepers and uploaded as <APP_ENV>/env/<time>.tar.age (spec
# 2026-10-23-offsite-backups O13, spec 2026-10-27-secret-store K10):
#   ( set -o pipefail; tar -C /opt/pharmacy/docker -cf - env/prod.env secrets/prod |
#     dc run --rm --no-deps -T backup pharmacy-backup env-push )
# The archive streams into age: the plain text is held neither in a variable (a tar holds NUL bytes) nor on a disk.
# Only its first block is read ahead — the tar header of the env file: name, size and mode, no content — so that an
# empty stdin or an env file piped in the old way is refused.
cmd_env_push() {
  offsite_enabled || die "copies off the host are not configured (BACKUP_OFFSITE_BUCKET is empty)"
  [ -t 0 ] && die "env-push: the tar of the env file and the secrets goes on stdin"
  recipients=$(age_recipients) || die "env-push: BACKUP_AGE_RECIPIENTS must hold public keys age1…, space-separated"
  name=$(date -u +%Y%m%dT%H%M%SZ)
  obj="$(offsite_prefix)/env/$name.tar.age"
  header="/tmp/pharmacy-env-$name.header"
  enc="/tmp/pharmacy-env-$name.age"
  err=/tmp/pharmacy-backup.offsite.err
  # fullblock: exactly one block, however the pipe splits it, and not a byte more (head -c reads ahead).
  dd bs=512 count=1 iflag=fullblock of="$header" 2>/dev/null
  first=$(dd if="$header" bs=100 count=1 2>/dev/null | tr -d '\000')
  magic=$(dd if="$header" bs=1 skip=257 count=5 2>/dev/null)
  if [ "$magic" != ustar ] || ! printf '%s' "$first" | grep -q '^env/[^/]*\.env$'; then
    rm -f "$header"
    die "env-push: stdin is not the tar of the env file and the secrets (env/<env>.env first)"
  fi
  # shellcheck disable=SC2086
  cat "$header" - | age $recipients -o "$enc" 2>"$err" ||
    { rm -f "$header" "$enc"; die "env-push: encryption failed: $(sanitize "$(tail -n 1 "$err")" | cut -c1-200)"; }
  rm -f "$header"
  bytes=$(stat -c %s "$enc")
  rclone copyto "$enc" "$obj" 2>"$err" ||
    { rm -f "$enc"; die "env-push: upload failed: $(sanitize "$(tail -n 1 "$err")" | cut -c1-200)"; }
  rm -f "$enc"
  [ "$(offsite_size "$obj")" = "$bytes" ] || die "env-push: the object of $name has another size after the upload"
  log "env-push: uploaded as ${obj#offsite:}"
}

# The secret files of docker/compose.secrets.yml (ADR-0021, spec 2026-10-27-secret-store, section 3).
SECRET_FILES='postgres_superuser_password pharmacy_owner_password pharmacy_app_password pharmacy_platform_password
pharmacy_backup_password redis_password redis_users_acl session_jwt_keys password_peppers offsite_secret_access_key'

# env_stream <archive> <tar arguments…> — the archive decrypted with KEY straight into tar; fails when either fails.
env_stream() {
  archive=$1
  shift
  (
    set -o pipefail
    printf '%s\n' "$KEY" | age -d -i /dev/stdin "$archive" | tar "$@"
  )
}

# env-open <archive> <dir> — after the loss of the server or a break-in (docs/guides/deploy-vps.md): an archive of
# env-push, decrypted with the private key of a keeper read from stdin (never stored), into <dir>
# (/opt/pharmacy/docker). Anyone with the bucket key can put an archive encrypted for the public keys there, so, as a
# copy in offsite_download, it is opened only when it holds the env file env/<env>.env and every secret file
# secrets/<env>/<name> as plain files: no links, no other paths (left-over dot files of the secrets directory are
# skipped). Only those are written, nothing that exists is overwritten, and they get the rights of ADR-0021: the env
# file 600, the secrets directory 700, its files 444. The plain text streams from age into tar and never lies on a disk.
# Runs without the stack, as the deploy user: docker run --rm -i --user … -v …:/w pharmacy/postgres:<tag> pharmacy-backup
# env-open /w/<time>.tar.age /w < key.txt
cmd_env_open() {
  archive=${1:-}
  dir=${2:-}
  { [ -f "$archive" ] && [ -d "$dir" ]; } ||
    die "usage: pharmacy-backup env-open <archive .tar.age> <directory> — the private key of a keeper on stdin"
  [ -t 0 ] && die "env-open: the private key of a keeper goes on stdin, it is never stored on this host"
  # In memory only; a key file saved on Windows has CRLF.
  KEY=$(tr -d '\r')
  printf '%s\n' "$KEY" | grep -q '^AGE-SECRET-KEY-1' ||
    die "env-open: stdin holds no private key of age (a line AGE-SECRET-KEY-1…)"
  err=/tmp/pharmacy-backup.env-open.err
  names=$(env_stream "$archive" -tf - 2>"$err") && long=$(env_stream "$archive" -tvf - 2>>"$err") ||
    die "env-open: the archive cannot be decrypted or read (the private key of a keeper?): $(sanitize "$(tail -n 1 "$err")" | cut -c1-200)"
  e=$(printf '%s\n' "$names" | sed -n 's|^env/\([a-z][a-z0-9]*\)\.env$|\1|p')
  [ "$(printf '%s\n' "$e" | grep -c .)" = 1 ] || die "env-open: the archive does not hold one env file env/<env>.env"
  expected=$({
    printf 'env/%s.env\n' "$e"
    for f in $SECRET_FILES; do printf 'secrets/%s/%s\n' "$e" "$f"; done
  } | sort)
  held=$(printf '%s\n' "$names" | grep -v -e '^env/\{0,1\}$' -e '^secrets/\{0,1\}$' -e "^secrets/$e/\{0,1\}\$" \
    -e "^secrets/$e/\.[^/]*\$" | sort)
  # busybox tar lists a symbolic link as l…, a hard link as -… <name> -> <target>
  if [ "$held" != "$expected" ] || printf '%s\n' "$long" | grep -q -e '^[^-d]' -e ' -> '; then
    die "env-open: the archive does not hold exactly env/$e.env and the secret files of secrets/$e/ as plain files"
  fi
  for f in $expected; do
    [ ! -e "$dir/$f" ] || die "env-open: $dir/$f already exists; nothing was written (it is never overwritten)"
  done
  mkdir -p "$dir/env" "$dir/secrets/$e" || die "env-open: $dir is not writable by uid $(id -u)"
  # shellcheck disable=SC2086
  env_stream "$archive" -xf - -C "$dir" $expected 2>"$err" ||
    die "env-open: unpacking failed: $(sanitize "$(tail -n 1 "$err")" | cut -c1-200)"
  unset KEY
  chmod 600 "$dir/env/$e.env" && chmod 700 "$dir/secrets/$e" && (cd "$dir/secrets/$e" && chmod 444 $SECRET_FILES) ||
    die "env-open: the rights of the files cannot be set"
  log "env-open: env/$e.env and $(printf '%s\n' $SECRET_FILES | grep -c .) secret files of secrets/$e/ are in $dir"
}

# fail <reason> — the copy in progress becomes <name>.failed with the reason and the tail of its log. Its dump is
# deleted: a failure that repeats hourly would otherwise fill BACKUP_DIR, and retention runs only after a success.
fail() {
  m_error="$1: $(tail -n 3 "$part/log.txt" 2>/dev/null)"
  m_finished=$(date +%s)
  rm -f "$part/pharmacy.dump"
  write_manifest "$part/manifest.json"
  mv "$part" "$BACKUP_ROOT/$m_name.failed"
  log "copy $m_name FAILED: $(sanitize "$m_error")"
  exit 1
}

cmd_run() {
  check_retention
  take_lock
  m_started=$(date +%s)
  m_name=$(date -u -d "@$m_started" +%Y%m%dT%H%M%SZ)
  m_server='' m_migration='' m_error='' m_verified=false
  m_bytes='' m_dump_s='' m_restore_s='' m_tables='' m_tenants=''
  preflight
  rc=$?
  [ "$rc" -eq 2 ] && exit 2
  # Under the lock a .partial directory is always the remainder of an interrupted run.
  rm -rf "$BACKUP_ROOT"/*.partial
  part="$BACKUP_ROOT/$m_name.partial"
  mkdir "$part" || die "cannot create $part"
  if [ "$rc" -ne 0 ]; then
    cat /tmp/pharmacy-backup.err >>"$part/log.txt" 2>/dev/null
    fail "the source database cannot be read"
  fi
  trap scratch_stop EXIT
  m_server=$(q "" "$DB_NAME" "show server_version" 2>>"$part/log.txt") || fail "the source database cannot be read"
  log "copy $m_name: started ($f_tenants networks)"

  pg_dumpall --globals-only --no-role-passwords -f "$part/globals.sql" 2>>"$part/log.txt" || fail "pg_dumpall failed"
  pg_dump -Fc --lock-wait-timeout=60s -f "$part/pharmacy.dump" 2>>"$part/log.txt" || fail "pg_dump failed"
  dump_facts "$part/pharmacy.dump" 2>>"$part/log.txt" || fail "the copy cannot be read"
  m_tables=$d_tables m_migration=$d_migration
  m_bytes=$(stat -c %s "$part/pharmacy.dump")
  m_dump_s=$(($(date +%s) - m_started))

  t0=$(date +%s)
  scratch_start || fail "the scratch instance did not start: $s_error"
  apply_globals "$SCRATCH_CONN" "$part/globals.sql" 2>>"$part/log.txt" || fail "the roles of the copy cannot be applied"
  restore_into "$SCRATCH_CONN" "$DB_NAME" "$part/pharmacy.dump" 2>>"$part/log.txt" || fail "pg_restore failed"
  check_restored "$SCRATCH_CONN" "$DB_NAME" "$m_tables" "$m_migration" || fail "$c_error"
  scratch_stop
  m_restore_s=$(($(date +%s) - t0))
  m_tenants=$c_tenants
  m_verified=true
  m_finished=$(date +%s)
  write_manifest "$part/manifest.json"
  rm -f "$part/log.txt"
  mv "$part" "$BACKUP_ROOT/$m_name" || die "cannot rename $part"
  log "copy $m_name: verified — $((m_bytes / 1048576)) MB, dump ${m_dump_s} s, restore ${m_restore_s} s, $m_tenants networks"
  retention
  # A failed upload leaves the copy verified and pending: the daemon tries again within an hour (spec O8).
  offsite_push
  exit 0
}

cmd_verify() {
  name=${1:-}
  dir="$BACKUP_ROOT/$name"
  m="$dir/manifest.json"
  { is_name "$name" && [ -f "$m" ]; } || die "no copy $name in $BACKUP_ROOT"
  take_lock
  trap scratch_stop EXIT
  t0=$(date +%s)
  scratch_start || die "the scratch instance did not start: $s_error"
  apply_globals "$SCRATCH_CONN" "$dir/globals.sql" || die "verify $name: the roles of the copy cannot be applied"
  restore_into "$SCRATCH_CONN" "$DB_NAME" "$dir/pharmacy.dump" || die "verify $name: pg_restore failed"
  check_restored "$SCRATCH_CONN" "$DB_NAME" "$(manifest_get "$m" tables)" "$(manifest_get "$m" lastMigration)" ||
    die "verify $name: $c_error"
  log "verify $name: ok — restore $(($(date +%s) - t0)) s, $c_tenants networks"
}

cmd_status() {
  now=$(date +%s)
  printf 'times: %s\n' "${TZ:-UTC}"
  printf '%-18s %-16s %-10s %-7s %8s %8s %8s  %-40s %s\n' copy taken state offsite size dump restore "last migration" \
    networks
  for d in "$BACKUP_ROOT"/*; do
    n=${d##*/}
    base=${n%.failed}
    base=${base%.partial}
    is_name "$base" || continue
    m="$d/manifest.json"
    case "$n" in
    *.partial) state=partial ;;
    *.failed) state=FAILED ;;
    *) if [ "$(manifest_get "$m" verified)" = true ]; then state=verified; else state=unverified; fi ;;
    esac
    bytes=$(manifest_get "$m" dumpBytes)
    off=''
    [ -f "$d/offsite.json" ] && off=yes
    printf '%-18s %-16s %-10s %-7s %5s MB %6ss %6ss  %-40s %s\n' "$base" "$(local_time "$(name_epoch "$base")")" \
      "$state" "$off" "$(( ${bytes:-0} / 1048576 ))" "$(manifest_get "$m" dumpSeconds)" \
      "$(manifest_get "$m" restoreSeconds)" "$(manifest_get "$m" lastMigration)" "$(manifest_get "$m" tenants)"
    [ "$state" = FAILED ] && printf '    error: %s\n' "$(manifest_get "$m" error)"
  done
  newest=$(newest_verified)
  if [ -n "$newest" ]; then
    age=$((now - $(manifest_get "$BACKUP_ROOT/$newest/manifest.json" finishedEpoch)))
    printf 'newest verified copy: %s, %d h %d min ago\n' "$newest" $((age / 3600)) $((age % 3600 / 60))
  else
    printf 'no verified copies\n'
  fi
  uploaded=$(newest_offsite)
  if [ -n "$uploaded" ]; then
    age=$((now - ${uploaded%% *}))
    printf 'newest copy off the host: %s, uploaded %d h %d min ago\n' "${uploaded#* }" $((age / 3600)) \
      $((age % 3600 / 60))
  fi
  case "$(cat "$STATE/offsite" 2>/dev/null)" in
  configured*) printf 'off the host: %s\n' "$(cut -d' ' -f2- "$STATE/offsite")" ;;
  error*) printf 'off the host: LAST UPLOAD FAILED %s\n' "$(cut -d' ' -f2- "$STATE/offsite")" ;;
  *) printf 'off the host: not configured — copies stay on this host only\n' ;;
  esac
  [ -f "$STATE/next" ] && printf 'next copy: %s\n' "$(local_time "$(cat "$STATE/next")")"
  [ -f "$STATE/blocked" ] && printf 'BLOCKED: %s\n' "$(cat "$STATE/blocked")"
  # The backup service could not write its state here (BACKUP_DIR not writable keeps the reason in its container).
  [ -d "$STATE" ] ||
    printf 'no state of the backup service in %s — if it is unhealthy, see: npm run stack -- <env> logs backup\n' \
      "$BACKUP_ROOT"
  return 0
}

cmd_health() {
  if [ -f "$STATE/blocked" ] || [ -f "$TMP_BLOCKED" ]; then exit 1; fi
  now=$(date +%s)
  # Off the host: prod without it is unhealthy (decision 7.1 of the security review); with it, the newest upload is
  # younger than 26 h. Both after the first 2 h of the container (spec O9), so `up --wait` of a deploy does not fail.
  in_grace=false
  [ $((now - $(cat "$STARTED" 2>/dev/null || echo 0))) -lt "$GRACE" ] && in_grace=true
  if offsite_enabled; then
    uploaded=$(newest_offsite)
    if [ -z "$uploaded" ] || [ $((now - ${uploaded%% *})) -ge "$HEALTHY_AGE" ]; then
      $in_grace || exit 1
    fi
  elif [ "${APP_ENV:-}" = prod ]; then
    $in_grace || exit 1
  fi
  newest=$(newest_verified)
  if [ -n "$newest" ]; then
    finished=$(manifest_get "$BACKUP_ROOT/$newest/manifest.json" finishedEpoch)
    [ $((now - ${finished:-0})) -lt "$HEALTHY_AGE" ] && exit 0
  fi
  $in_grace && exit 0
  exit 1
}

next_slot() {
  slot=$(date -d "$BACKUP_TIME" +%s)
  [ "$slot" -gt "$(date +%s)" ] || slot=$((slot + 86400)) # Asia/Dushanbe has no daylight saving time
  printf '%s' "$slot"
}

cmd_daemon() {
  case "$BACKUP_TIME" in
  [01][0-9]:[0-5][0-9] | 2[0-3]:[0-5][0-9]) ;;
  *) die "BACKUP_TIME must be HH:MM, got '$BACKUP_TIME'" ;;
  esac
  check_retention
  date +%s >"$STARTED"
  log "daemon: a copy every day at $BACKUP_TIME (${TZ:-UTC}), verified copies kept $RETENTION_DAYS days, in $BACKUP_ROOT"
  now=$(date +%s)
  preflight
  rc=$?
  newest=$(newest_verified)
  # next_slot is always ahead, so one day earlier is the last BACKUP_TIME that has passed. A copy interrupted by a
  # restart (a deploy recreates postgres and backup) or a night missed while the container was down is made at once.
  last_slot=$(($(next_slot) - 86400))
  if [ "$rc" -eq 2 ]; then
    next=$((now + RETRY))
  elif [ -z "$newest" ] || [ "$(name_epoch "$newest")" -lt "$last_slot" ]; then
    next=$now
  else
    next=$(next_slot)
  fi
  # Copies not yet off the host are uploaded at the start and then every hour (spec O8); without pending copies a push
  # touches nothing remote.
  next_push=$now
  offsite_enabled || offsite_state disabled
  while :; do
    { printf '%s\n' "$next" >"$STATE/next"; } 2>/dev/null
    [ "$next" -gt "$(date +%s)" ] && log "next copy at $(local_time "$next")"
    while [ "$(date +%s)" -lt "$next" ]; do
      if offsite_enabled && [ "$(date +%s)" -ge "$next_push" ]; then
        "$0" push
        next_push=$(($(date +%s) + RETRY))
      fi
      left=$((next - $(date +%s)))
      sleep $((left < 300 ? left : 300))
    done
    "$0" run
    rc=$?
    now=$(date +%s)
    case "$rc" in
    0) next=$(next_slot) ;;
    1)
      slot=$(next_slot)
      next=$((now + RETRY < slot ? now + RETRY : slot))
      ;;
    *) next=$((now + RETRY)) ;;
    esac
  done
}

cmd_restore() {
  name=${1:-}
  check=${2:-}
  dir="$BACKUP_ROOT/$name"
  m="$dir/manifest.json"
  db=${POSTGRES_DB:-pharmacy}
  target="${db}_restore"
  old="${db}_before_$(printf '%s' "$name" | tr 'A-Z' 'a-z')"
  conn="-h /var/run/postgresql -U ${POSTGRES_USER:-postgres}"
  unset PGHOST PGPORT PGUSER PGDATABASE
  # the socket asks the superuser for its password in test and prod (docker/postgres/pg_hba.conf, Z6); there it comes
  # from its file (compose secrets, ADR-0021)
  if [ -n "${POSTGRES_PASSWORD_FILE:-}" ]; then
    PGPASSWORD=$(cat "$POSTGRES_PASSWORD_FILE") || die "cannot read POSTGRES_PASSWORD_FILE ($POSTGRES_PASSWORD_FILE)"
  else
    PGPASSWORD=${POSTGRES_PASSWORD:-}
  fi
  export PGPASSWORD
  { is_name "$name" && [ -f "$m" ]; } || die "no copy $name in $BACKUP_ROOT"
  [ "$(manifest_get "$m" verified)" = true ] || die "copy $name is not verified"
  { [ -f "$dir/pharmacy.dump" ] && [ -f "$dir/globals.sql" ]; } || die "copy $name is incomplete"
  taken=$(q "$conn" postgres "select count(*) from pg_database where datname = '$old'") ||
    die "cannot query the server as ${POSTGRES_USER:-postgres} over the local socket"
  [ "$taken" = 0 ] ||
    die "database $old already exists: it is the database replaced when copy $name was restored before; check that it is not needed, then drop it"
  printf 'copy %s, taken %s (%s), %s MB, last migration %s, %s networks\n' "$name" \
    "$(local_time "$(name_epoch "$name")")" "${TZ:-UTC}" "$(($(manifest_get "$m" dumpBytes) / 1048576))" \
    "$(manifest_get "$m" lastMigration)" "$(manifest_get "$m" tenants)"
  printf 'database %s is restored as %s, then %s is renamed to %s and %s to %s\n' "$db" "$target" "$db" "$old" \
    "$target" "$db"
  [ "$check" = --check ] && exit 0

  log "restore $name: into $target"
  q "$conn" postgres "drop database if exists \"$target\"" >/dev/null || die "cannot drop $target"
  apply_globals "$conn" "$dir/globals.sql" || die "restore $name: the roles of the copy cannot be applied"
  if ! restore_into "$conn" "$target" "$dir/pharmacy.dump" ||
    ! check_restored "$conn" "$target" "$(manifest_get "$m" tables)" "$(manifest_get "$m" lastMigration)"; then
    q "$conn" postgres "drop database if exists \"$target\"" >/dev/null
    die "restore $name failed${c_error:+: $c_error}; database $db is untouched"
  fi
  present=$(q "$conn" postgres "select count(*) from pg_database where datname = '$db'") ||
    die "cannot query the server; $target holds the restored copy, database $db is untouched"
  if [ "$present" = 1 ]; then
    q "$conn" postgres "alter database \"$db\" allow_connections false" >/dev/null || die "cannot close $db"
    tries=0
    until err=$(q "$conn" postgres "alter database \"$db\" rename to \"$old\"" 2>&1 >/dev/null); do
      tries=$((tries + 1))
      if [ "$tries" -gt 10 ]; then
        # The working database stays as it was and takes connections again, so the stack can start.
        q "$conn" postgres "alter database \"$db\" allow_connections true" >/dev/null
        die "cannot rename $db to $old: $(sanitize "$err"); $db is open again and untouched, $target holds the restored copy"
      fi
      q "$conn" postgres "select count(pg_terminate_backend(pid)) from pg_stat_activity where datname = '$db'" >/dev/null
      sleep 1
    done
  fi
  if ! err=$(q "$conn" postgres "alter database \"$target\" rename to \"$db\"" 2>&1 >/dev/null); then
    if [ "$present" = 1 ]; then
      q "$conn" postgres "alter database \"$old\" rename to \"$db\"" >/dev/null &&
        q "$conn" postgres "alter database \"$db\" allow_connections true" >/dev/null
    fi
    die "cannot rename $target to $db: $(sanitize "$err"); the previous database is back as $db, $target holds the restored copy"
  fi
  log "restore $name: done; the previous database is kept as $old (no connections allowed)"
}

# Secrets of the backup service from files (compose secrets, ADR-0021). rclone takes its key from its variable only,
# so the key is in the environment of this process and its children — never in the configuration of the container.
if [ -n "${PGPASSWORD_FILE:-}" ]; then
  PGPASSWORD=$(cat "$PGPASSWORD_FILE") || die "cannot read PGPASSWORD_FILE ($PGPASSWORD_FILE)"
  export PGPASSWORD
fi
if [ -n "${RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY_FILE:-}" ]; then
  s3_key=$(cat "$RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY_FILE") ||
    die "cannot read RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY_FILE ($RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY_FILE)"
  if [ -n "$s3_key" ]; then
    RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=$s3_key
    export RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY
  fi
  unset s3_key
fi

case "${1:-}" in
daemon) cmd_daemon ;;
run) cmd_run ;;
verify) cmd_verify "${2:-}" ;;
status) cmd_status ;;
health) cmd_health ;;
restore) cmd_restore "${2:-}" "${3:-}" ;;
push) cmd_push ;;
list-offsite) cmd_list_offsite "${2:-}" "${3:-}" ;;
fetch) cmd_fetch "${2:-}" "${3:-}" "${4:-}" ;;
verify-offsite) cmd_verify_offsite "${2:-}" "${3:-}" "${4:-}" ;;
env-push) cmd_env_push ;;
env-open) cmd_env_open "${2:-}" "${3:-}" ;;
*) die "usage: pharmacy-backup daemon | run | push | verify <copy> | status | health | restore <copy> [--check] | list-offsite [--at <time>] | fetch <copy> [--at <time>] | verify-offsite <copy> [--at <time>] | env-push | env-open <archive> <dir>" ;;
esac
