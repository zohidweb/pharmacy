{
  "name": "@pharmacy/web",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "web",
    "sourceRoot": "apps/web/src",
    "tags": [
      "scope:web",
      "type:app"
    ],
    "targets": {
      "dev": {
        "options": {
          "command": "next dev -p 4200"
        }
      },
      "fsd": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/src/**/*",
          "{projectRoot}/steiger.config.mjs"
        ],
        "options": {
          "command": "steiger ./src",
          "cwd": "{projectRoot}"
        }
      }
    }
  },
  "dependencies": {
    "next": "~16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
