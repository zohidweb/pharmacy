# Build context is the repo root; keep it small and free of secrets.
**/node_modules
**/dist
**/out
**/.next
**/test-output
**/coverage
.nx
.git
.idea
.vscode
.claude
# Secrets: env files anywhere in the tree (compose reads docker/env/*.env from the host, not the context)
**/.env
**/.env.*
**/*.env
docker/env
# The secret files of test and prod (ADR-0021): compose mounts them from the host, never from the context
docker/secrets
!**/*.env.example
!**/.env.example
**/*.pem
**/*.key
docs
templates
# the camera reader: the image copies it from its own npm ci (ADR-0025)
apps/web/public/vendor/*.wasm
