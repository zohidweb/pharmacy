# Copy to .env (never commit .env). Values below are placeholders for local development only.

# apps/api
NODE_ENV=development
PORT=3000

# docker/compose.dev.yml — local PostgreSQL / Redis
POSTGRES_DB=pharmacy
POSTGRES_USER=pharmacy_owner
POSTGRES_PASSWORD=change-me-local-only

# Used by apps/api once the data layer (ADR-0006) and sessions (ADR-0008) are implemented
# DATABASE_URL=postgres://pharmacy_app:change-me-local-only@127.0.0.1:5432/pharmacy
# REDIS_URL=redis://127.0.0.1:6379
