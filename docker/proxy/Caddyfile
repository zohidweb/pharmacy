# Reverse proxy of Pharmacy (ADR-0012): TLS, static web/admin, /api on the same origin.
# One file for every place; the place is chosen by environment variables (docker/env/*.env):
#   PROXY_PROFILE  cloud (web, admin, apex redirect) | local (web, admin) | offline (http://localhost, web only)
#   TLS_MODE       acme (Let's Encrypt, ACME_EMAIL) | internal (Caddy's local CA, *.localhost) |
#                  files (/certs/cert.pem, /certs/key.pem) | off (plain http:// addresses)
#   WEB_ADDR, ADMIN_ADDR, APEX_ADDR, WEB_ORIGIN, PROXY_HTTP_PORT, PROXY_HTTPS_PORT, API_UPSTREAM,
#   OPERATOR_ALLOW (addresses that reach the admin host, CIDR, space-separated)
# {$VAR} is substituted before the file is parsed.
{
	# configuration changes = new image or restart (ADR-0012)
	admin off
	http_port {$PROXY_HTTP_PORT:80}
	https_port {$PROXY_HTTPS_PORT:443}
	servers {
		# Caddy has no server timeouts by default: slow clients would hold connections forever. read_body fits a 10 MiB
		# import over a ~1 Mbit/s uplink; write counts from the request headers, so it covers the body, the 120 s answer
		# of sync and imports and the response (ADR-0012, amendment 2026-10-23).
		timeouts {
			read_header 10s
			read_body 120s
			write 300s
			idle 2m
		}
	}
}

(tls-acme) {
	tls {$ACME_EMAIL}
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

(tls-files) {
	tls /certs/cert.pem /certs/key.pem
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

(tls-internal) {
	tls internal
}

(tls-off) {
}

(access-log) {
	# Cookie, Set-Cookie and Authorization are redacted by Caddy; query strings carry no secrets (ADR-0008).
	log {
		output stdout
		format json
	}
}

# Upstream of the API with the timeouts of ADR-0012; args[0] — response header timeout.
(upstream) {
	reverse_proxy {$API_UPSTREAM:api:3000} {
		transport http {
			dial_timeout 5s
			response_header_timeout {args[0]}
		}
		# No API answer is stored by the browser, whatever the API sends (security review 2026-10-22, P1 and 7.2).
		header_down Cache-Control "no-store"
	}
}

# A compressed request body only on the sync contour (security review 2026-10-22, A3 and 7.2); the API refuses it too.
(plain-body) {
	@encoded header Content-Encoding *
	respond @encoded 415
}

# The API of tenant employees and offline stores. The operator contour lives on the admin host only
# (an echelon; the API checks the contour itself).
(api-tenant) {
	@operator path /api/v1/operator /api/v1/operator/*
	handle @operator {
		respond 404
	}
	# Sizes in MiB, as the API counts them (a cap below the API's would answer an empty 413 instead of its problem).
	# offline store batches: up to 2 MiB of JSON after gzip, checked by the API body parser (ADR-0014)
	handle /api/v1/sync/* {
		request_body {
			max_size 4MiB
		}
		encode zstd gzip
		import upstream 120s
	}
	# data import from a file (spec 2026-10-20-data-import, F19); before /api/*, which would cap it at 1 MiB
	@imports path_regexp ^/api/v1/(catalog|opening-balance|supplier)-imports(/checks)?/?$
	handle @imports {
		import plain-body
		request_body {
			max_size 10MiB
		}
		encode zstd gzip
		import upstream 120s
	}
	handle /api/* {
		import plain-body
		request_body {
			max_size 1MiB
		}
		encode zstd gzip
		import upstream 30s
	}
}

# The admin host passes the operator contour only.
(api-operator) {
	# site picture upload (ADR-0023): JSON with base64, up to 3 MiB as the API counts it; before @operator, which would
	# cap it at 1 MiB. Still inside the admin host's OPERATOR_ALLOW guard (the snippet is imported from its handle).
	@siteMedia path /api/v1/operator/site-media
	handle @siteMedia {
		import plain-body
		request_body {
			max_size 3MiB
		}
		encode zstd gzip
		import upstream 30s
	}
	@operator path /api/v1/operator /api/v1/operator/*
	handle @operator {
		import plain-body
		request_body {
			max_size 1MiB
		}
		encode zstd gzip
		import upstream 30s
	}
	handle /api/* {
		respond 404
	}
}

# Static export of Next.js: every route is its own HTML, no SPA fallback (ADR-0012).
# Inline scripts are allowed until build-time hashes (RSC payload of Next, ADR-0012 «Принятие», 4).
(static-files) {
	handle {
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			Cross-Origin-Opener-Policy same-origin
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
		}
		header /_next/static/* Cache-Control "public, max-age=31536000, immutable"
		header ?Cache-Control "no-cache"
		# trailingSlash is false in the export: /stock/ → /stock instead of a 404. Only plain route segments: the decoded
		# path may hold a backslash or a tab, and /%5Cevil.com/ would redirect to /\evil.com — another site for a browser.
		@trailing path_regexp trailing ^((?:/[A-Za-z0-9._~-]+)+)/$
		redir @trailing {re.trailing.1}{?query} 308
		try_files {path} {path}.html {path}/index.html
		file_server {
			precompressed br gzip
		}
	}
}

# handle_errors belongs to the site block itself: apart from the files, so the admin site can nest those in a handle.
(static-errors) {
	handle_errors 404 {
		# not the immutable of /_next/static/*: a missing file must not stay missing in the browser for a year
		header Cache-Control "no-cache"
		rewrite * /404.html
		file_server
	}
}

(static) {
	import static-files
	import static-errors
}

(web-site) {
	import tls-{$TLS_MODE}
	import access-log
	root * /srv/web
	import api-tenant
	import static
}

# Operators only (security review 2026-10-22, A1 and decision 7.2): the admin and /api/v1/operator/* answer the
# addresses of OPERATOR_ALLOW (CIDR, space-separated: the operator offices, the VPN), others get 403 — a leaked operator
# password is not enough from anywhere else.
(admin-site) {
	import tls-{$TLS_MODE}
	import access-log
	root * /srv/admin
	@outsider not remote_ip {$OPERATOR_ALLOW}
	handle @outsider {
		respond 403
	}
	handle {
		import api-operator
		import static-files
	}
	import static-errors
}

# Container health (Dockerfile HEALTHCHECK); not published.
http://:8081 {
	respond /healthz 200
	respond 404
}

import /etc/caddy/profiles/{$PROXY_PROFILE}.caddy
