# Build context is the repo root; keep it small and free of secrets.
**/node_modules
**/dist
**/out
**/.next
**/test-output
**/coverage
.nx
.git
.idea
.vscode
.claude
# Secrets: env files anywhere in the tree (compose reads docker/env/*.env from the host, not the context)
**/.env
**/.env.*
**/*.env
docker/env
!**/*.env.example
!**/.env.example
**/*.pem
**/*.key
docs
templates
